import React from 'react';
import './index.css';

const App: React.FC = () => {
  return (
    <div className="wrapper"><h1 className="title"><%= pluginName %></h1>
      <p className="desc">
        <span className="desc-text">🛠️ Get started by editing</span>
        <pre className="desc-entry"><%= entryPath %></pre>
      </p>
      <div className="btn-group"><% docs.forEach(function(doc){ %>
        <a onClick={() => window.JSSDK.navigation.open("<%= doc.url %>")} className="<% if (doc.type==='primary' ) { %>primary<% } else { %>secondary<% } %>">
          <span><%= doc.text %></span>
        </a><% }); %>
       </div>
    </div>
  );
}

export default App;